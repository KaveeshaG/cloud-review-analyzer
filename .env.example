# Project Configuration
PROJECT_ID=your-gcp-project-id
REGION=us-central1
ENVIRONMENT=development

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Service URLs (for local development)
API_GATEWAY_URL=http://localhost:8080
REVIEW_INGESTION_URL=http://localhost:8081
AI_ANALYSIS_URL=http://localhost:8082
ANALYTICS_URL=http://localhost:8083

# Cloud Storage
REVIEW_BUCKET=product-reviews-raw

# Pub/Sub
PUBSUB_TOPIC=review-submitted
PUBSUB_SUBSCRIPTION=review-submitted-sub

# Firestore
FIRESTORE_DATABASE=(default)

# Logging
LOG_LEVEL=info
ENABLE_CLOUD_LOGGING=true

# Development Settings
NODE_ENV=development
PORT=8080